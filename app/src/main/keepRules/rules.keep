# Native symbols resolve these class and method names at runtime.
-keep,allowoptimization class com.easytier.jni.EasyTierJNI {
    native <methods>;
}
-keep,allowoptimization class cc.ptoe.easytier.compose.transport.root.RootTunNative {
    native <methods>;
}

# libsu's separate assets/main.jar invokes this method through reflection.
-keep,allowoptimization class com.topjohnwu.superuser.ipc.RootService {
    protected void attachBaseContext(android.content.Context);
}
-keep,allowoptimization class cc.ptoe.easytier.compose.transport.root.EasyTierRootService {
    public <init>();
}

# Keep warnings and errors. Remove diagnostic calls and unused arguments.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}
